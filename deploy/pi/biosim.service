[Unit]
Description=Bio-Signal Emulator (biomonitor simulator)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=biosim
Group=biosim
WorkingDirectory=/opt/biosim/app
Environment=BIOSIM_DATA_DIR=/var/lib/biosim
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/biosim/venv/bin/python run.py --host 0.0.0.0 --port 5445
Restart=always
RestartSec=3
LimitNOFILE=65535
# shared-memory segments + worker processes are cleaned up on stop
KillMode=mixed
TimeoutStopSec=20
Nice=-5

[Install]
WantedBy=multi-user.target
